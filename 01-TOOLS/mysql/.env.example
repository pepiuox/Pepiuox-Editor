# Plantilla de credenciales de MySQL. Este archivo SÍ se confirma en git.
#
# Úsalo así:
#   cp 01-TOOLS/mysql/.env.example 01-TOOLS/mysql/.env
# y rellena los valores reales. El .env no se confirma.

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_editor_db
DB_USER=web_editor_app
DB_PASSWORD=cambia_esta_contraseña
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_uca1400_ai_ci

# Cuenta de administración del servidor (no la usa la aplicación). Hace falta para el cliente
# de consola, para importar volcados y para phpMyAdmin. Ver 01-TOOLS/mysql/CREDENTIALS.md.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=cambia_esta_contraseña

# Token de las tareas programadas (`/cron/*`).
#
# Sin este valor, TODOS los endpoints /cron/* responden 401. Es a propósito:
# uno de ellos escribe en la base de datos, y cerrar por defecto es lo correcto
# cuando el secreto no existe.
#
# Genera uno con:
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# y pégalo aquí. La comparación es en tiempo constante.
CRON_TOKEN=

# URL pública del sitio, para el sitemap y los enlaces absolutos.
#
# En desarrollo puede quedarse vacía: se usa http://localhost:170. Al publicar,
# pon aquí el dominio real, sin barra final y sin /public:
#   APP_URL=https://mi-dominio.com
#
# Si además guardas una URL en «Sitemap» desde el panel, manda la del panel.
# Un sitemap con localhost no lo indexa ningún buscador: la aplicación avisa
# cuando detecta esa situación.
APP_URL=
