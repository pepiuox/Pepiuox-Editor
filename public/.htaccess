# ═══════════════════════════════════════════════════════════════════
# PePiuoX Editor - Configuración Apache
# ═══════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # ═══ PASAR HEADER AUTHORIZATION A PHP ═══
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # ═══ PROTEGER CARPETAS SENSIBLES ═══
    RewriteRule ^(config|app|views|storage|db)/ - [F,L]
    
    # ═══ PROTECCIÓN CONTRA INYECCIONES ═══
    RewriteCond %{QUERY_STRING} base64_encode[^(]*\([^)]*\) [OR]
    RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule ^ - [F,L]
    
    # ═══ FICHEROS SUBIDOS (uploads/ vive fuera del document root) ═══
    # Regla relativa a este directorio: cubre tanto /uploads/... como
    # /public/uploads/... (las URLs que genera url('uploads/...')).
    RewriteRule ^uploads/(.+)$ uploads.php [L,QSA]

    # ═══ ARCHIVOS ESTÁTICOS (servir directamente) ═══
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # ═══ RUTAS ESPECIALES ═══
    RewriteRule ^sitemap\.xml$ index.php [L]
    RewriteRule ^robots\.txt$ index.php [L]
    
    # ═══ TODAS LAS DEMÁS RUTAS → index.php ═══
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ═══════════════════════════════════════════════════════════════════
# HEADERS DE SEGURIDAD
# ═══════════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ═══════════════════════════════════════════════════════════════════
# DESHABILITAR LISTADO DE DIRECTORIOS
# ═══════════════════════════════════════════════════════════════════
Options -Indexes

# ═══════════════════════════════════════════════════════════════════
# PROTEGER ARCHIVOS SENSIBLES
# ═══════════════════════════════════════════════════════════════════
<FilesMatch "\.(env|sql|log|md|ini|conf|bak|git|gitignore|yml|yaml)$">
    Require all denied
</FilesMatch>